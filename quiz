    starredKeys.forEach(key => {
      const parts = key.split('||');
      const item = document.createElement('div');
      item.className = 'notebook-item';
      const encodedKey = encodeURIComponent(key);
      item.innerHTML = `<div><span>${parts[0]}</span> — <span style="color:var(--text-muted);">${parts[1]}</span></div>
      <button style="background:none; border:none; cursor:pointer;" onclick="removeStarFromNotebook('${encodedKey}')">🗑</button>`;
      list.appendChild(item);
    });
  }
  document.getElementById('notebookModal').style.display = 'flex';
}

