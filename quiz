  document.getElementById('feedback').textContent='';
  document.getElementById('next').style.display='none';
  document.getElementById('skipBtn').style.display='inline-flex';
  document.getElementById('audioBtn').style.display='none';

  const progressPercent = ((current) / cards.length) * 100;
  document.getElementById('progressBar').style.width = `${progressPercent}%`;

  const optionsBox = document.getElementById('options');
  const flashcardArea = document.getElementById('flashcardArea');
  const wordRow = document.getElementById('wordRow');
  const currentCard = cards[current];

  document.getElementById('starBtn').classList.toggle('active', starredKeys.has(getCardKey(currentCard)));

  if(selectedMode === 'flashcard'){
    wordRow.style.display = 'none';
    optionsBox.style.display = 'none';
    flashcardArea.style.display = 'flex';
    document.getElementById('flashcard').classList.remove('flipped');
    document.getElementById('cardFrontText').textContent = currentCard.ru;
    document.getElementById('cardBackText').textContent = currentCard.tr;
    document.getElementById('counter').textContent = `Kart ${current+1} / ${cards.length}`;
    return;
  } else {
    wordRow.style.display = 'flex';
    flashcardArea.style.display = 'none';
  }

  if(selectedMode.startsWith('sentence')){
    const item = currentCard;
    document.getElementById('word').textContent = item.sentence;
    document.getElementById('audioBtn').style.display = 'inline-flex';
    optionsBox.style.display = 'grid';

    let choices = [...item.choices]; shuffle(choices);
    currentCorrectAnswer = item.blank;
    optionsBox.innerHTML = '';
    choices.forEach((choice, index) => {
      const btn = document.createElement('button');
      btn.className = 'option';
      btn.innerHTML = `<span class="option-badge">${index + 1}</span>${choice}`;
      btn.onclick = () => answerSentence(btn, choice, item);
      optionsBox.appendChild(btn);
    });

    document.getElementById('counter').textContent = `Cümle ${current+1} / ${cards.length}`;
    document.getElementById('score').textContent = `Doğru: ${score}`;
    return;
  }

  const direction = document.getElementById('quizDirectionSelect').value;
  const isRuToTr = (direction === 'ru_tr');

  document.getElementById('word').textContent = isRuToTr ? currentCard.ru : currentCard.tr;
  currentCorrectAnswer = isRuToTr ? currentCard.tr : currentCard.ru;
  optionsBox.style.display = 'grid';

  let pool = (selectedMode === 'web_words' || selectedMode === 'flashcard') ? webWordsPool : (allCards.length > 0 ? allCards : webWordsPool);
  let wrong = pool.filter(c => (isRuToTr ? c.tr : c.ru) !== currentCorrectAnswer);
  shuffle(wrong);

  const choices = [currentCorrectAnswer, ...wrong.slice(0, 3).map(c => isRuToTr ? c.tr : c.ru)];
  shuffle(choices);

  optionsBox.innerHTML = '';
  choices.forEach((choice, index) => {
    const btn = document.createElement('button');
    btn.className = 'option';
    btn.innerHTML = `<span class="option-badge">${index + 1}</span>${choice}`;
    btn.onclick = () => answer(btn, choice, currentCorrectAnswer);
    optionsBox.appendChild(btn);
  });

  document.getElementById('counter').textContent = `Soru ${current+1} / ${cards.length}`;
  document.getElementById('score').textContent = `Doğru: ${score}`;
}

function flipCard(){ document.getElementById('flashcard').classList.toggle('flipped'); }
function nextFlashcard(){ current < cards.length - 1 ? (current++, showQuestion()) : finishQuiz(); }
function prevFlashcard(){ if(current > 0){ current--; showQuestion(); } }

function answerSentence(btn, choice, item){
  if(answered) return; answered = true;
  document.querySelectorAll('.option').forEach(b => {
    b.classList.add('disabled');
    if(b.textContent.replace(/^[1-4]/, '').trim() === item.blank) b.classList.add('correct');
  });

  if(choice === item.blank){
    btn.classList.add('correct'); score++; playSuccessSound();
    document.getElementById('feedback').style.color = 'var(--duo-green)';
    document.getElementById('feedback').textContent = `✓ DOĞRU! — "${item.tr}"`;
  } else {
    btn.classList.add('wrong'); playWrongSound(); playSentenceMP3();
    if(!wrongCards.includes(item)) wrongCards.push(item);
    updateWrongBtnDisplay();
    document.getElementById('feedback').style.color = 'var(--duo-red)';
    document.getElementById('feedback').textContent = `✗ YANLIŞ! DOĞRUSU: "${item.full}"`;
  }
  document.getElementById('score').textContent = `Doğru: ${score}`;
  document.getElementById('next').style.display = 'inline-flex';
  document.getElementById('skipBtn').style.display = 'none';
}

function answer(btn, choice, correct){
  if(answered) return; answered = true;
  document.querySelectorAll('.option').forEach(b => {
    b.classList.add('disabled');
    if(b.textContent.replace(/^[1-4]/, '').trim() === correct) b.classList.add('correct');
  });

  if(choice === correct){ 
    btn.classList.add('correct'); score++; playSuccessSound();
    document.getElementById('feedback').style.color = 'var(--duo-green)';
    document.getElementById('feedback').textContent = 'EFSANE! DOĞRU CEVAP 🎉';
  } else { 
    btn.classList.add('wrong'); playWrongSound();
    if(!wrongCards.includes(cards[current])) wrongCards.push(cards[current]);
    updateWrongBtnDisplay();
    document.getElementById('feedback').style.color = 'var(--duo-red)';
    document.getElementById('feedback').textContent = `ÜZGÜNÜM! DOĞRUSU: ${correct}`;
  }

  document.getElementById('score').textContent = `Doğru: ${score}`;
  document.getElementById('next').style.display = 'inline-flex';
  document.getElementById('skipBtn').style.display = 'none';
}

function skipQuestion(){
  if(answered) return;
  current++;
  if(current >= cards.length) finishQuiz();
  else showQuestion();
}

function finishQuiz(){
  document.getElementById('progressBar').style.width = `100%`;
  if (typeof confetti === 'function') confetti({ particleCount: 120, spread: 70, origin: { y: 0.6 } });
  document.getElementById('wordRow').style.display = 'none';
  document.getElementById('options').style.display = 'none';
  document.getElementById('controlsArea').style.display = 'none';
  document.getElementById('audioBtn').style.display = 'none';
  
  let wrongBtnHtml = wrongCards.length > 0 ? `<button class="duo-btn duo-btn-red" style="margin-top:15px;" onclick="startWrongQuiz()">⚠️ YANLIŞLARLA TEKRAR YAP (${wrongCards.length})</button><br>` : '';
  
  document.getElementById('endStats').innerHTML = `
    <h2 style="font-size:28px; font-weight:900; color:var(--duo-green);">TEBRİKLER! TESTİ TAMAMLADIN 🔥</h2>
    <h3 style="font-size:22px;">Toplam Skor: ${score} / ${cards.length}</h3>
    ${wrongBtnHtml}
    <button class="duo-btn duo-btn-blue" style="margin-top:10px;" onclick="goToHomeScreen()">ANA EKRANA DÖN</button>
  `;
}

document.getElementById('next').onclick = () => {
  current++;
  if(current >= cards.length) finishQuiz();
  else showQuestion();
};

document.addEventListener('keydown', (e) => {
  if (document.getElementById('quiz').style.display !== 'block') return;
  if (['1', '2', '3', '4'].includes(e.key) && !answered) {
    const options = document.querySelectorAll('.option');
    if (options[parseInt(e.key) - 1]) options[parseInt(e.key) - 1].click();
  } else if (e.code === 'Space') {
    e.preventDefault();
    if (answered && document.getElementById('next').style.display !== 'none') {
      document.getElementById('next').click();
    }
  }
});
</script>
</body>
