document.getElementById('fileInput').addEventListener('change', async function(e){
  const file=e.target.files[0]; if(!file) return;
  try{
    const data=await file.arrayBuffer();
    const wb=XLSX.read(data,{type:'array'});
    const ws=wb.Sheets[wb.SheetNames[0]];
    const rows=XLSX.utils.sheet_to_json(ws,{header:1,defval:''});
    allCards=rows.map(r=>{
      if(!r || r.length<2) return null;
      const question=String(r[0]??'').trim(); let answer='';
      for(let i=r.length-1;i>=1;i--){ if(String(r[i]??'').trim()){ answer=String(r[i]).trim(); break; } }
      return question && answer ? {ru: question, tr: answer}:null;
    }).filter(Boolean);
    
    const fileBtn = document.getElementById('uploadFileBtn');
    fileBtn.className = "duo-btn duo-btn-green";
    fileBtn.textContent = "📁 Dosya Seçildi ✓";

  }catch(err){ alert('Excel okunamadı.'); }
});

function initQuizFromExcel(){
  selectedMode = document.getElementById('quizModeSelect').value;
  let poolToUse = [];

  if(selectedMode === 'sentence_a1' || selectedMode === 'sentence_a2'){
    const category = document.getElementById('categorySelect').value;
    if(category === 'all'){
      Object.values(sentenceCategories).forEach(arr => poolToUse.push(...arr));
    } else {
      poolToUse = sentenceCategories[category] || [];
    }
  } else if(selectedMode === 'web_words' || selectedMode === 'flashcard'){
    poolToUse = [...webWordsPool];
  } else {
    poolToUse = allCards.length > 0 ? [...allCards] : [...webWordsPool];
  }

  const onlyStarred = document.getElementById('onlyStarredCheck').checked;
  if(onlyStarred){
    poolToUse = poolToUse.filter(c => starredKeys.has(getCardKey(c)));
    if(poolToUse.length === 0){
      alert("Bu modda işaretlenmiş yıldızlı kelime bulunamadı.");
      return;
    }
  }

  let desiredCount = parseInt(document.getElementById('questionCountInput').value);
  if(isNaN(desiredCount) || desiredCount <= 0 || desiredCount > poolToUse.length){ desiredCount = poolToUse.length; }

  shuffle(poolToUse);
  cards = poolToUse.slice(0, desiredCount);
  initialCards = [...cards];
  wrongCards = [];
  current = 0; score = 0;

  updateWrongBtnDisplay();
  document.getElementById('uploadArea').style.display='none';
  document.getElementById('quiz').style.display='block';
  showQuestion();
}

function updateWrongBtnDisplay(){
  const wrongBtn = document.getElementById('wrongQuizBtn');
  if(wrongCards.length > 0 && selectedMode !== 'flashcard'){
    wrongBtn.style.display = 'inline-flex';
    wrongBtn.textContent = `⚠️ YANLIŞLAR (${wrongCards.length})`;
  } else {
    wrongBtn.style.display = 'none';
  }
}

function startWrongQuiz(){
  if(wrongCards.length === 0) return;
  cards = [...wrongCards];
  wrongCards = [];
  current = 0; score = 0;
  updateWrongBtnDisplay();
  showQuestion();
}

function restartCurrentQuiz(){
  cards = [...initialCards];
  wrongCards = [];
  current = 0; score = 0;
  updateWrongBtnDisplay();
  showQuestion();
}

function shuffle(a){ for(let i=a.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [a[i],a[j]]=[a[j],a[i]]; } return a; }

function showQuestion(){
