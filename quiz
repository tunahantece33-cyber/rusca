function playGoogleTTS(text) {
  if(!text) return;
  let cleanText = text.replace(/_____/g, '').trim();
  let url = `https://translate.google.com/translate_tts?ie=UTF-8&tl=ru&client=tw-ob&q=${encodeURIComponent(cleanText)}`;
  new Audio(url).play().catch(e => console.log("Ses oynatılamadı:", e));
}

